        }
      ]
    },
    {
      "type": "row",
      "title": "Devices",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "id": 50
    },
    {
      "type": "timeseries",
      "title": "Per-vdev error increase (read / write / cksum)",
      "id": 51,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(zfs_pool_vdev_errors_total{instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval]) > 0",
          "legendFormat": "{{instance}}/{{pool}} {{vdev}} {{type}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total vdev errors (all time)",
      "id": 52,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(zfs_pool_vdev_errors_total{instance=~\"$instance\",pool=~\"$pool\"}) or vector(0)"
        }
      ]
    },
    {
      "type": "row",
      "title": "ARC / ZIL (kstat)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "id": 60
    },
    {
      "type": "timeseries",
      "title": "ARC hit ratio",
      "id": 61,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 59
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_zfs_arc_hits{instance=~\"$instance\"}[5m]) / (rate(node_zfs_arc_hits{instance=~\"$instance\"}[5m]) + rate(node_zfs_arc_misses{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ARC size vs target",
      "id": 62,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 59
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_zfs_arc_size{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} size"
        },
        {
          "refId": "B",
          "expr": "node_zfs_arc_c{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} target"
        },
        {
          "refId": "C",
          "expr": "node_zfs_arc_c_max{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "ZIL commit rate",
      "id": 63,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 59
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_zfs_zil_zil_commit_count{instance=~\"$instance\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
