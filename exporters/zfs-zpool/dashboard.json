{
  "id": null,
  "uid": "zfs-pools",
  "title": "ZFS Pools",
  "tags": [
    "zfs",
    "storage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(zfs_pool_health, instance)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Instance"
      },
      {
        "name": "pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(zfs_pool_health{instance=~\"$instance\"}, pool)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Pool health & capacity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Pools",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "H",
          "expr": "zfs_pool_health_state{instance=~\"$instance\",pool=~\"$pool\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "zfs_pool_capacity_ratio{instance=~\"$instance\",pool=~\"$pool\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "zfs_pool_fragmentation_ratio{instance=~\"$instance\",pool=~\"$pool\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "S",
          "expr": "zfs_pool_size_bytes{instance=~\"$instance\",pool=~\"$pool\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "pool",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "group": true,
              "Value #H": true
            },
            "renameByName": {
              "state": "Health",
              "Value #C": "Used",
              "Value #F": "Frag",
              "Value #S": "Size",
              "instance": "Host"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Frag"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Capacity used",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 7,
        "x": 9,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zfs_pool_capacity_ratio{instance=~\"$instance\",pool=~\"$pool\"}",
          "legendFormat": "{{instance}}/{{pool}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Unhealthy pools",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(zfs_pool_health{instance=~\"$instance\",pool=~\"$pool\"} == 0) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Scrub / resilver running",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(zfs_pool_scrub_in_progress{instance=~\"$instance\",pool=~\"$pool\"}) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Oldest scrub age",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdhms",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1209600
              },
              {
                "color": "red",
                "value": 2592000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - zfs_pool_last_scrub_timestamp_seconds{instance=~\"$instance\",pool=~\"$pool\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Collector freshness",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - zfs_textfile_last_run_timestamp_seconds{instance=~\"$instance\"})"
        }
      ]
    },
    {
      "type": "row",
      "title": "Throughput",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "IOPS",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "R",
          "expr": "rate(zfs_pool_reads_total{instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval])",
          "legendFormat": "{{instance}}/{{pool}} read"
        },
        {
          "refId": "W",
          "expr": "rate(zfs_pool_writes_total{instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval])",
          "legendFormat": "{{instance}}/{{pool}} write"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bandwidth",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "R",
          "expr": "rate(zfs_pool_read_bytes_total{instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval])",
          "legendFormat": "{{instance}}/{{pool}} read"
        },
        {
          "refId": "W",
          "expr": "rate(zfs_pool_written_bytes_total{instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval])",
          "legendFormat": "{{instance}}/{{pool}} write"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue depth (active)",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zfs_pool_queue_depth{instance=~\"$instance\",pool=~\"$pool\",state=\"active\"} > 0",
          "legendFormat": "{{instance}}/{{pool}} {{queue}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency distribution — $instance",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 20,
      "repeat": "instance",
      "repeatDirection": "v"
    },
    {
      "type": "heatmap",
      "title": "Total wait — read",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "reverse": true
        },
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left"
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "legend": {
          "show": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(zfs_pool_latency_seconds_bucket{instance=~\"$instance\",pool=~\"$pool\",class=\"total_wait\",op=\"read\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Total wait — write",
      "id": 22,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "reverse": true
        },
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left"
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "legend": {
          "show": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(zfs_pool_latency_seconds_bucket{instance=~\"$instance\",pool=~\"$pool\",class=\"total_wait\",op=\"write\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Disk wait — read",
      "id": 23,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "reverse": true
        },
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left"
        },
        "tooltip": {
          "show": true,
