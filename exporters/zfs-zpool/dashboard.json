          "legendFormat": "{{instance}} p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le, instance, pool) (rate(zfs_pool_latency_seconds_bucket{instance=~\"$instance\",pool=~\"$pool\",class=\"total_wait\",op=\"write\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} p95"
