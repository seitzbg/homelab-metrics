        {
          "refId": "A",
          "expr": "sum by (le) (rate(zfs_pool_io_size_bytes_bucket{instance=~\"$instance\",pool=~\"$pool\",class=~\"sync_write|async_write\"}[$__rate_interval]))",
          "format": "heatmap",
