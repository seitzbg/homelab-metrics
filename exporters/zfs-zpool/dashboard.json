      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(zfs_pool_latency_seconds_bucket{instance=~\"$instance\",pool=~\"$pool\",class=\"disk_wait\",op=\"read\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Disk wait — write",
      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "options": {
