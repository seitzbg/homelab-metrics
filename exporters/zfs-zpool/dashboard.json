      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(zfs_pool_latency_seconds_bucket{instance=~\"$instance\",pool=~\"$pool\",class=\"disk_wait\",op=\"write\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency quantiles",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 30
    },
    {
      "type": "timeseries",
      "title": "Total wait quantiles — read",
      "id": 31,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "P50",
          "expr": "histogram_quantile(0.50, sum by (le, instance, pool) (rate(zfs_pool_latency_seconds_bucket{instance=~\"$instance\",pool=~\"$pool\",class=\"total_wait\",op=\"read\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} p50"
        },
        {
          "refId": "P95",
          "expr": "histogram_quantile(0.95, sum by (le, instance, pool) (rate(zfs_pool_latency_seconds_bucket{instance=~\"$instance\",pool=~\"$pool\",class=\"total_wait\",op=\"read\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} p95"
        },
        {
          "refId": "P99",
          "expr": "histogram_quantile(0.99, sum by (le, instance, pool) (rate(zfs_pool_latency_seconds_bucket{instance=~\"$instance\",pool=~\"$pool\",class=\"total_wait\",op=\"read\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total wait quantiles — write",
      "id": 32,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
