        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(qbittorrent_torrents_count{status=~\"error|missingFiles\"})",
          "legendFormat": "Errored"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(qbittorrent_torrents_count{status=~\"checkingDL|checkingUP|checkingResumeData|moving|allocating\"})",
          "legendFormat": "Checking / moving"
        }
