# Single .env, shared by both services in compose.yaml via env_file — each
# exporter only reads the variables it defines below; the two exporters'
# variable names don't collide (verified against both upstream sources).

# ============================================================
# qbittorrent-exporter (esanchezm/prometheus-qbittorrent-exporter)
# ============================================================

# REQUIRED. Bare hostname of the qBittorrent WebUI (no port — the
# exporter always joins QBITTORRENT_HOST and QBITTORRENT_PORT itself).
QBITTORRENT_HOST=qbittorrent.example.org

# REQUIRED. WebUI port. There is no default — confirmed against the
# pinned v1.7.0 image: with this unset the exporter logs "No port
# specified, please set QBITTORRENT_PORT environment variable" and
# exits(1), which under `restart: unless-stopped` is a crash-restart
# loop, not a container that starts cleanly.
QBITTORRENT_PORT=8080

# REQUIRED unless you use QBITTORRENT_API_KEY instead (qBittorrent 5.2+).
# Credentials for the qBittorrent WebUI (Tools > Options > Web UI).
QBITTORRENT_USER=admin
QBITTORRENT_PASS=changeme

# Optional. qBittorrent 5.2+ bearer-token auth, as an alternative to
# QBITTORRENT_USER/QBITTORRENT_PASS.
# QBITTORRENT_API_KEY=

# Optional. Set to "true" if the WebUI is behind HTTPS.
# QBITTORRENT_SSL=false

# Optional. Address/port the exporter's own HTTP server binds to inside
# the container. Only change EXPORTER_PORT if you also change the
# `ports:` mapping in compose.yaml (and the dashboard's job= scrape
# target — the reference deployment scrapes job "qbittorrent" on :8000).
# EXPORTER_ADDRESS=0.0.0.0
# EXPORTER_PORT=8000

# Optional. Prefix applied to every emitted metric name (the dashboard
# expects the default "qbittorrent" prefix — only change this if you also
# edit dashboard.json's queries to match).
# METRICS_PREFIX=qbittorrent

# ============================================================
# sabnzbd-exporter (onedr0p/exportarr, run as `exportarr sabnzbd` — see
# compose.yaml's `command:`). These variable names are exportarr's own
# generic names (shared across all the *arr apps it supports), not
# SABnzbd-specific — they apply only to the sabnzbd-exporter service.
# ============================================================

# REQUIRED. Full base URL to the SABnzbd WebUI/API.
URL=http://sabnzbd.example.org:8080

# REQUIRED (or API_KEY_FILE below). SABnzbd API key — SABnzbd web UI >
# Config > General > "API Key".
API_KEY=changeme

# Optional. Alternative to API_KEY: path (inside the container) to a file
# containing the key, e.g. for Docker/Kubernetes secrets. Overrides
# API_KEY if set.
# API_KEY_FILE=

# REQUIRED (in practice). The exportarr image's own Dockerfile default is
# PORT=9707 (a generic default shared by every *arr app it can export —
# exportarr instances must each use a unique port when run side by side),
# NOT 8081 — confirmed against the pinned v2.3.0 image's actual startup
# log ("Starting HTTP Server" on :9707) when PORT was left unset. Set it
# explicitly to match this compose's `ports:` mapping and the dashboard's
# job= scrape target (reference deployment scrapes job "sabnzbd" on
# :8081).
PORT=8081
# INTERFACE=0.0.0.0

# Optional. Set to "true" to skip TLS certificate verification against
# the SABnzbd URL (self-signed certs).
# DISABLE_SSL_VERIFY=false

# Optional. LOG_LEVEL: debug|info|warn|error|dpanic|panic|fatal.
# LOG_FORMAT: console|json.
# LOG_LEVEL=info
# LOG_FORMAT=console
