# kea-exporter reads its config from environment variables (all map 1:1 to
# the `kea-exporter` CLI flags; see README for the full picture).

# REQUIRED. One or more targets, space-separated. Each target is either:
#   - an HTTP(S) URL to a Kea Control Agent (recommended) — a single CA
#     endpoint auto-discovers and queries BOTH the dhcp4 and dhcp6 daemons
#     configured under its `control-sockets`, so one URL is normally enough
#     for a dual-stack setup; or
#   - a filesystem path to a Kea control socket (DHCP4 and DHCP6 each have
#     their own socket — pass both paths to monitor both stacks). Requires
#     bind-mounting the socket(s) into the container; see compose.yaml.
#
# HTTP Control-Agent example (covers DHCP4 + DHCP6 via one CA):
TARGETS=http://kea-control-agent.example.org:8000/
#
# UDS example instead (DHCP4 and DHCP6 sockets separately, space-separated;
# paths must match the volumes: mounts in compose.yaml):
# TARGETS=/run/kea/kea4-ctrl-socket /run/kea/kea6-ctrl-socket

# Optional. Address/port the exporter's own HTTP server binds to inside the
# container. Defaults shown; only change PORT if you also change the
# `ports:` mapping in compose.yaml (and the dashboard's job= scrape target).
# ADDRESS=0.0.0.0
# PORT=9547

# Optional. Minimum seconds between two queries to Kea (throttles polling
# when something scrapes /metrics more often than you want Kea hit).
# Default 0 = query Kea fresh on every scrape.
# INTERVAL=15

# Optional. Client TLS cert/key, if the Kea Control Agent requires mutual
# TLS. Paths are inside the container — bind-mount the files alongside
# these if set.
# CLIENT_CERT=/etc/kea-exporter/client.crt
# CLIENT_KEY=/etc/kea-exporter/client.key

# Optional. CA bundle path (inside the container) to validate a
# self-signed certificate on the Kea Control Agent. This is a standard
# `requests` library env var, not a kea-exporter-specific flag.
# REQUESTS_CA_BUNDLE=/etc/kea-exporter/ca.crt
