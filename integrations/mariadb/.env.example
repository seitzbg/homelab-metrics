# mysqld_exporter (>= v0.15.0, which this bundle pins) removed the old
# monolithic DATA_SOURCE_NAME env var. Modern config is either a mounted
# `my.cnf`-style file (--config.my-cnf) or these two pieces:
#   - target host:port + username -> flags, interpolated into compose.yaml's
#     `command:` from the two variables below
#   - password -> read directly by the exporter from MYSQLD_EXPORTER_PASSWORD
# See README.md for the least-privilege monitoring-user grant.

# host:port of the MySQL/MariaDB server to monitor.
MYSQLD_ADDRESS=127.0.0.1:3306

# Least-privilege monitoring user (see README).
MYSQLD_USERNAME=exporter

# Read directly by mysqld_exporter (the exporter's own env var name, not
# ours to rename).
MYSQLD_EXPORTER_PASSWORD=changeme
