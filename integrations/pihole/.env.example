# Pi-hole v6 target the exporter authenticates against and polls.
PIHOLE_HOSTNAME=pihole.example.com
PIHOLE_PORT=80
PIHOLE_PROTOCOL=http
# Pi-hole v6 "app password" (Settings > Web Interface/API > Expert mode >
# Configure app password) — NOT your admin login password. See README.md.
PIHOLE_PASSWORD=changeme

# Port/address the exporter itself listens on.
PORT=9617
# BIND_ADDR=0.0.0.0

# Optional tuning (uncomment to override the exporter's defaults).
# TIMEOUT=5s
# SKIP_TLS_VERIFICATION=false
# DEBUG=false
