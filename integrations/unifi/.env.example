# UniFi Network controller connection. Variable names/prefix ("UP_") are
# unpoller's own env-var config scheme (golift.io/cnfg, prefix "UP",
# pkg/poller/config.go: ENVConfigPrefix = "UP") — verified against the
# pinned v3.4.1 source, not guessed. These map onto the [unifi.defaults]
# section of unpoller's TOML config (examples/up.conf.example in the
# unpoller repo); with dynamic=false (the default) this is also the only
# controller unpoller polls.
UP_UNIFI_DEFAULT_URL=https://unifi.example.com
UP_UNIFI_DEFAULT_USER=unpoller
UP_UNIFI_DEFAULT_PASS=changeme

# API-key auth instead of user/pass (newer UniFi Network releases support
# per-admin API keys). Exclusive of UP_UNIFI_DEFAULT_USER/PASS above — set
# this and drop the two above instead, don't set both.
# UP_UNIFI_DEFAULT_API_KEY=changeme

# UniFi's controller cert is self-signed by default; leave false unless
# you've replaced it with a trusted one.
UP_UNIFI_DEFAULT_VERIFY_SSL=false

# Verbose per-device debug logging.
UP_POLLER_DEBUG=false

# Prometheus output plugin. Enabled (disable=false) is unpoller's own
# documented default, but this bundle only wires up Prometheus (no
# InfluxDB/Loki/Datadog output), so it's set explicitly rather than relied
# on implicitly.
UP_PROMETHEUS_DISABLE=false

# Optional: metric name prefix (default "unpoller", matching the
# `unpoller_*` series the bundled dashboards query) and the listen
# address/port /metrics is served on (default "0.0.0.0:9130", matching
# this compose file's port mapping). Uncomment only to override either
# default.
# UP_PROMETHEUS_NAMESPACE=unpoller
# UP_PROMETHEUS_HTTP_LISTEN=0.0.0.0:9130
