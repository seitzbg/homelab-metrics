# Proxmox VE API credentials, read straight from the environment by the
# exporter itself (src/pve_exporter/config.py: config_from_env()). Setting
# PVE_USER at all switches the exporter into env-var config mode; without
# it, it instead tries to read /etc/prometheus/pve.yml at startup (not
# mounted by this compose file) and fails to start.
PVE_USER=prometheus@pve

# Token auth (recommended — see README for the `pveum user token add`
# steps). Leave both set for token auth; the exporter passes them straight
# to proxmoxer's ProxmoxAPI().
PVE_TOKEN_NAME=prompve-scraper
PVE_TOKEN_VALUE=changeme

# Password auth instead of a token: comment out PVE_TOKEN_NAME/VALUE above
# and uncomment this instead.
# PVE_PASSWORD=changeme

# Verify the PVE node's TLS certificate. Proxmox ships a self-signed cert
# by default; leave false unless you've replaced it with a trusted one.
PVE_VERIFY_SSL=false

# Optional: name of the config "module" this env-var set is registered
# under (only matters if you also keep a multi-module pve.yml around).
# Defaults to "default".
# PVE_MODULE=default
