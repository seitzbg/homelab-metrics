            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (instance) (rate(dnsdist_cache_hits{instance=~\"${instance:regex}\"}[5m])) / (sum by (instance) (rate(dnsdist_cache_hits{instance=~\"${instance:regex}\"}[5m])) + sum by (instance) (rate(dnsdist_cache_misses{instance=~\"${instance:regex}\"}[5m])))",
