    {
      "id": 14,
      "type": "timeseries",
      "title": "Loki store on-disk",
      "description": "Real on-disk size of the Loki data volume (the Loki data volume), measured directly by du on the observability host and shipped via the node_exporter textfile collector (a scheduled du job). Loki's filesystem store has no size gauge of its own, and its volume is folded into the host's / — invisible to node_filesystem_* and cAdvisor. 'allocated' = actual disk blocks consumed (the true footprint); 'apparent' = logical data size — on ZFS with many small chunk files these diverge ~2x.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "loki_disk_usage_bytes{instance=~\"$instance\",kind=\"allocated\"}",
          "legendFormat": "allocated (on disk)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "loki_disk_usage_bytes{instance=~\"$instance\",kind=\"apparent\"}",
          "legendFormat": "apparent (logical)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "allocated (on disk)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#A5D6A7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "apparent (logical)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#90CAF9"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
