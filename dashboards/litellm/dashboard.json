      "id": 22,
      "type": "timeseries",
      "title": "Time to first token p95 by model",
      "description": "STREAMING REQUESTS ONLY — LiteLLM only observes this metric on streamed completions, so a non-streaming client (a plain curl, most scripts) contributes nothing and this panel stays empty. Open WebUI streams, so its traffic does show here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
