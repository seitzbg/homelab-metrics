        "h": 8
      },
      "targets": [
        {
          "expr": "topk(10, sum by (service) (rate(traefik_service_requests_total{instance=~\"$instance\"}[$__rate_interval])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
