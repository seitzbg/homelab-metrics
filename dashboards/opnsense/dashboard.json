        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "label_replace(rate(pf_searches{job=\"opnsense-telegraf\"}[5m]), \"nodename\", \"$1\", \"host\", \"([^.]+).*\")",
