      "title": "CPU & Memory",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU used %",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(100 - avg by (instance) (rate(node_cpu_seconds_total{job=\"opnsense-node\",mode=\"idle\"}[5m])) * 100) * on(instance) group_left(nodename) node_uname_info{job=\"opnsense-node\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory breakdown (per host)",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(node_memory_active_bytes{job=\"opnsense-node\"} + node_memory_wired_bytes{job=\"opnsense-node\"} + node_memory_laundry_bytes{job=\"opnsense-node\"}) * on(instance) group_left(nodename) node_uname_info{job=\"opnsense-node\"}",
          "legendFormat": "{{nodename}} used",
          "refId": "A"
        },
        {
          "expr": "(node_memory_inactive_bytes{job=\"opnsense-node\"} + node_memory_cache_bytes{job=\"opnsense-node\"} + node_memory_free_bytes{job=\"opnsense-node\"}) * on(instance) group_left(nodename) node_uname_info{job=\"opnsense-node\"}",
          "legendFormat": "{{nodename}} avail",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Network",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Interface throughput — RX",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(12, rate(node_network_receive_bytes_total{job=\"opnsense-node\",device!~\"lo0|pflog.*|enc.*|usbus.*\"}[5m]) * 8 * on(instance) group_left(nodename) node_uname_info{job=\"opnsense-node\"})",
          "legendFormat": "{{nodename}} · {{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Interface throughput — TX",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "topk(12, rate(node_network_transmit_bytes_total{job=\"opnsense-node\",device!~\"lo0|pflog.*|enc.*|usbus.*\"}[5m]) * 8 * on(instance) group_left(nodename) node_uname_info{job=\"opnsense-node\"})",
          "legendFormat": "{{nodename}} · {{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Filesystem",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Filesystem used % (zfs / ufs)",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(100 * (1 - node_filesystem_avail_bytes{job=\"opnsense-node\",fstype=~\"zfs|ufs\"} / node_filesystem_size_bytes{job=\"opnsense-node\",fstype=~\"zfs|ufs\"})) * on(instance) group_left(nodename) node_uname_info{job=\"opnsense-node\"}",
          "legendFormat": "{{nodename}} · {{mountpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#A5D6A7",
                "value": null
              },
              {
                "color": "#FFE082",
                "value": 75
              },
              {
                "color": "#FFAB91",
                "value": 85
              },
              {
                "color": "#EF9A9A",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
