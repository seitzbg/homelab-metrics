{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(time() - node_boot_time_seconds{job=\"opnsense-node\"}) * on(instance) group_left(nodename) node_uname_info{job=\"opnsense-node\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#A5D6A7",
                "value": null
              }
            ]
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Load (1m)",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "node_load1{job=\"opnsense-node\"} * on(instance) group_left(nodename) node_uname_info{job=\"opnsense-node\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#A5D6A7",
                "value": null
              },
              {
                "color": "#FFE082",
                "value": 2
              },
              {
                "color": "#FFAB91",
                "value": 4
              },
              {
                "color": "#EF9A9A",
                "value": 8
              }
            ]
          },
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memory used %",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(100 * (node_memory_active_bytes{job=\"opnsense-node\"} + node_memory_wired_bytes{job=\"opnsense-node\"} + node_memory_laundry_bytes{job=\"opnsense-node\"}) / node_memory_size_bytes{job=\"opnsense-node\"}) * on(instance) group_left(nodename) node_uname_info{job=\"opnsense-node\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#A5D6A7",
                "value": null
              },
              {
                "color": "#FFE082",
                "value": 70
              },
              {
                "color": "#FFAB91",
                "value": 85
              },
              {
                "color": "#EF9A9A",
                "value": 95
              }
            ]
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 150,
      "type": "row",
      "title": "Packet Filter",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Active states (pf_entries)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "label_replace(pf_entries{job=\"opnsense-telegraf\"}, \"nodename\", \"$1\", \"host\", \"([^.]+).*\")",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#A5D6A7",
                "value": null
              },
              {
                "color": "#FFE082",
                "value": 50000
              },
              {
                "color": "#FFAB91",
                "value": 100000
              },
              {
                "color": "#EF9A9A",
                "value": 200000
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "State table size",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "label_replace(pf_entries{job=\"opnsense-telegraf\"}, \"nodename\", \"$1\", \"host\", \"([^.]+).*\")",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
