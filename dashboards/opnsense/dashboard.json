        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "label_replace(rate(pf_inserts{job=\"opnsense-telegraf\"}[5m]), \"nodename\", \"$1\", \"host\", \"([^.]+).*\")",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5,
            "fillOpacity": 10,
